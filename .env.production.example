# === Database ===
POSTGRES_DB=onlyglamps
POSTGRES_USER=onlyglamps
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# === MinIO (S3 storage) ===
MINIO_ROOT_USER=onlyglamps_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# === Nginx ===
# Port on host (8080 to avoid conflict with existing site on port 80)
NGINX_PORT=8080

# === MinIO ports (avoid conflict with existing services) ===
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# === Telegram Auth ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
